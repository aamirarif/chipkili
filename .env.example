# ChipKili settings. Copy to .env.local (development) or the container env (production).
# Never commit real values.

# Where data lives: "file" (local JSON, development) or "supabase" (production)
DATA_BACKEND=file
DATA_DIR=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site (used in links, sitemaps, share cards)
SITE_URL=https://chipkili.com
# Serve Admin only on this host in production (the public host then returns 404 for /admin)
ADMIN_HOST=admin.chipkili.com

# 32+ random characters; signs the verified-phone and admin cookies
SESSION_SECRET=

# Admin sign-in: run  npm run admin:setup -- owner "a long password" --write .env.local
ADMIN_USER=owner
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

# Texts, calls and email. Anything other than "live" is dry-run: nothing is sent, all goes to data/outbox.log
NOTIFY_MODE=dry
TELNYX_API_KEY=
TELNYX_FROM=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_CALL_CONTROL_APP_ID=
TELNYX_VOICE_FROM=
TELNYX_PUBLIC_KEY=
ZOHO_USER=
ZOHO_PASSWORD=
ZOHO_HOST=smtp.zoho.com
MAIL_FROM=noreply@chipkili.com

# Bing/IndexNow instant indexing (optional)
INDEXNOW_KEY=

# Uploads
MAX_VIDEO_MB=80
